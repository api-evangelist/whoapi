    "_postman_id": "8134475c-cceb-46cf-8d00-cd2c6e70fa29",
    "name": "WhoAPI Domain Intelligence API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "WhoAPI exposes WHOIS, domain availability, domain age, domain score, SSL certificate, email score, IP/domain blacklist, and website screenshot data through a single HTTP GET endpoint. The task is selected with the `r` parameter and authenticated with an `apikey` query parameter. Responses are gzip-compressed JSON carrying a numeric `status` and a `status_desc`.\nThis specification was generated by the API Evangelist enrichment pipeline from WhoAPI's published documentation (https://whoapi.com/api-documentation/) — it faithfully captures the documented request contract; response schemas are modeled at the envelope level only, not fabricated per task.\n\nContact Support:\n Name: WhoAPI Support",
      "type": "text/plain"
    }
  }
